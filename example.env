# ================================
# 🚀 APP CONFIGURATION
# ================================

# The port on which the server will run
PORT=8000

# Application environment (development | production | test)
NODE_ENV="development"

# Base URL of the API (useful for emails, callbacks, etc.)
BASE_URL="http://localhost:8000"



# ================================
# 🔐 AUTHENTICATION (JWT)
# ================================

# Secret key used to sign JWT tokens
# ❗ IMPORTANT: Use a strong, random value in production
JWT_SECRET_KEY="your_super_secure_random_secret"

# Token expiration time
# Examples:
# 7d = 7 days
# 1h = 1 hour
# 30m = 30 minutes
JWT_EXPIRE_TIME="7d"



# ================================
# 💳 PAYMENT (STRIPE)
# ================================

# Stripe secret API key
# Get it from:
# https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY="sk_test_xxxxxxxxxxxxx"

# Webhook secret used to verify incoming Stripe events
# Important for securing your webhook endpoint
STRIPE_WEBHOOK_SECRET="whsec_xxxxxxxxxxxxx"



# ================================
# 📧 EMAIL CONFIGURATION (SMTP)
# ================================

# Email service provider (SMTP host)
# Examples:
# smtp.gmail.com
# smtp.mailtrap.io
EMAIL_HOST="smtp.example.com"

# SMTP port
# 587 → TLS
# 465 → SSL
EMAIL_PORT=587

# Email address used to send emails
EMAIL_USER="your@email.com"

# Email password or App Password
# ⚠️ For Gmail, use an App Password instead of your main password
EMAIL_PASSWORD="your_email_password"



# ================================
# 🗄️ DATABASE (MongoDB)
# ================================

# Database connection string
# Local example:
DB_URI="mongodb://127.0.0.1:27017/ecommerce"

# Production example (MongoDB Atlas):
# DB_URI="mongodb+srv://user:password@cluster.mongodb.net/ecommerce"